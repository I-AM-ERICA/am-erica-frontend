# 홍보·고객응대·경영에 적용됩니다. 정책 채팅은 항상 백엔드의 스트리밍 API를 호출합니다.
# demo: 브라우저에서 예시 템플릿을 사용합니다.
# live: /api/assistants/{policy|marketing|customer|sales}로 요청합니다.
VITE_API_MODE=demo

# 로컬은 비워 두세요. GitHub Pages에서는 백엔드 HTTPS 원점(/api 제외)을 설정합니다.
# 예: https://api.example.com
VITE_API_BASE_URL=

# 네이버 개발자 센터에서 발급받은 공개 Client ID (Client Secret은 백엔드에만 설정)
VITE_NAVER_CLIENT_ID=
# 네이버에 등록한 Callback URL과 정확히 일치해야 합니다. 해시(#) 없이 입력하세요.
# GitHub Pages에서는 https://i-am-erica.github.io/am-erica-frontend/ 를 사용합니다.
VITE_NAVER_REDIRECT_URI=http://localhost:7001/api/auth/callback/naver

# 선택: 스태프 이미지의 staff 폴더 공개 URL. 미설정 시 아래 주소를 기본으로 사용합니다.
# 공개 이미지이므로 Supabase API 키/Secret은 필요하지 않습니다.
VITE_STAFF_IMAGE_BASE_URL=https://iyfmiswfprjohqoffugb.supabase.co/storage/v1/object/public/frontend-image/staff
